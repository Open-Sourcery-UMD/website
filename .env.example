GOOGLE_CALENDAR_API_KEY=example-key-123
EMAIL_API_KEY=example-key-123

# GitHub API Configuration (for Open Sourcery bot account)
# Get a Personal Access Token from https://github.com/settings/tokens
# Token needs: repo (full), admin:org_hook, admin:repo_hook
GITHUB_TOKEN=your_github_bot_token_here
NEXT_PUBLIC_GITHUB_ORG=Open-Sourcery-UMD

FIREBASE_SERVICE_ACCOUNT_KEY=example-key-123

# Discord bot for the Open Sourcery UMD server (roles, project channels,
# invites, #project-updates announcements). Create an application at
# https://discord.com/developers/applications, add a bot, enable the
# "Server Members Intent", and invite it with Manage Roles + Manage Channels.
# Its role must sit above "Lead Developers" and "Developers".
DISCORD_BOT_TOKEN=
# Optional: defaults to the Open Sourcery UMD server and its public invite
DISCORD_GUILD_ID=1385618525879668838
DISCORD_INVITE_URL=https://discord.com/invite/BWvbpgskZT