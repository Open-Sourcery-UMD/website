GOOGLE_CALENDAR_API_KEY=example-key-123
EMAIL_API_KEY=example-key-123

# GitHub API Configuration (for Open Sourcery bot account)
# Get a Personal Access Token from https://github.com/settings/tokens
# Token needs: repo (full), admin:org_hook, admin:repo_hook
GITHUB_TOKEN=your_github_bot_token_here
NEXT_PUBLIC_GITHUB_ORG=Open-Sourcery-UMD